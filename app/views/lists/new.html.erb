<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <h1>Create a new list</h1>

      <%= simple_form_for @list do |f| %>
        <%= f.input :name %>
        <%= f.submit "Create List", class: "btn btn-success" %>
        <%= link_to "Cancel", lists_path, class: "btn btn-secondary" %>
      <% end %>
    </div>
  </div>
</div>

<div class="bg-dark text-white text-center p-5">
  <h1><%= @list.name %></h1>
</div>

<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center">
    <h2>Movies</h2>

    <%= link_to "Add a movie",
        new_list_bookmark_path(@list),
        class: "btn btn-success" %>
  </div>

  <% if @list.movies.empty? %>
    <p>No movies in this list yet.</p>
  <% end %>

  <div class="row mt-4">
    <% @list.bookmarks.each do |bookmark| %>
      <div class="col-md-6 mb-4">
        <div class="card shadow-sm h-100">

          <%= image_tag bookmark.movie.poster_url,
              class: "card-img-top",
              style: "height: 300px; object-fit: cover;" %>

          <div class="card-body">
            <h3><%= bookmark.movie.title %></h3>

            <p>
              <i class="fa-solid fa-star text-warning"></i>
              <%= bookmark.movie.rating %>/10
            </p>

            <p><%= bookmark.movie.overview %></p>

            <hr>

            <p><%= bookmark.comment %></p>

            <%= link_to "Remove movie",
                bookmark_path(bookmark),
                class: "btn btn-outline-danger",
                data: { turbo_method: :delete,
                        turbo_confirm: "Are you sure?" } %>
          </div>

        </div>
      </div>
    <% end %>
  </div>

  <%= link_to "Back to lists", lists_path,
      class: "btn btn-secondary" %>
</div>

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <h1>Add a movie</h1>

      <%= simple_form_for [@list, @bookmark] do |f| %>
        <%= f.association :movie %>
        <%= f.input :comment %>

        <%= f.submit "Add movie", class: "btn btn-success" %>

        <%= link_to "Cancel", list_path(@list),
            class: "btn btn-secondary" %>
      <% end %>
    </div>
  </div>
</div>
